.DS_Store
settings.local.json
CLAUDE.local.md
setup-vertex-credentials.sh

# lavish skill generates throwaway reviewable HTML artifacts here — not dotfiles.
.lavish/



# Warp worktrees live under ~/.warp/worktrees/<repo>/<branch>/ and contain
# checkouts of unrelated repositories — never track them as dotfile content.
dot-warp/worktrees/

# Optional Warp helper: typescript-language-server installed via npm into
# ~/.warp/typescript-language-server/. node_modules tree, do not track.
dot-warp/typescript-language-server/

# Ad-hoc local backups (e.g. dot-claude/settings.json.bak) — scratch, never
# dotfile content.
*.bak

# 1Password writes this empty marker itself; machine-local state, not config.
dot-config/1Password/telemetry-enabled

# gh rewrites hosts.yml itself on every `gh auth login` / `gh auth switch`, and
# it is per-machine account state: the tokens live in the login keychain, so the
# file only ever names accounts another machine cannot authenticate as. Tracked
# until dotfiles-2ft, and churned by account switching the whole time.
dot-config/gh/hosts.yml

# Generated trust bundle (corporate-ca-bundle). Only ever appears here if stow
# folded ~/.config into dot-config/, which would route the write into the repo.
# Machine-specific, derived from the keychain, and this repo is public — the
# anchors must not be committed. See dotfiles-3x1.
dot-config/corporate-ca.crt

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
