# GitHub has no block here: git reaches it over HTTPS with the gh shim's token
# (dot-gitconfig), so neither account needs an SSH key. A remote still spelled
# git@github.com: or git@github-personal: is rewritten to HTTPS before ssh is
# ever run.

# Work hosts from the private work branch, then machine-local hosts, untracked
# here. A missing file is not an error.
Include config.work
Include config.local

Match host * exec "test $(uname) = Darwin"
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Match host * exec "test $(uname) = Linux"
	IdentityAgent ~/.1password/agent.sock
