#!/usr/bin/env bash
#
# The Archon slice pipeline's only test seam. Its workflow YAML has none of
# its own: a shell body inlined in a workflow file can only be exercised by
# running the workflow, so every non-trivial step for a slice lives here
# instead, where bats can drive it directly.

set -uo pipefail

usage() {
	echo "usage: slice-wave <branch-name|claim|release|verify-commit|validate|review-round|merge|close> ..." >&2
}

# Prints the branch git-check-ref-format accepts for $1, or returns 2 with
# nothing on stdout. The refs/heads/ form validates without needing to run
# inside a repository.
derive_branch() {
	local bead="$1" sanitized
	sanitized="$(printf '%s' "$bead" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-')"

	while [ -n "$sanitized" ]; do
		case "$sanitized" in
			.* | -* | _*) sanitized="${sanitized:1}" ;;
			*) break ;;
		esac
	done
	while [ -n "$sanitized" ]; do
		case "$sanitized" in
			*. | *- | *_) sanitized="${sanitized%?}" ;;
			*) break ;;
		esac
	done
	[ -n "$sanitized" ] || return 2

	local candidate="slice/$sanitized"
	git check-ref-format "refs/heads/$candidate" >/dev/null 2>&1 || return 2
	printf '%s' "$candidate"
}

cmd_branch_name() {
	local bead="${1:-}" branch
	if ! branch="$(derive_branch "$bead")"; then
		echo "slice-wave: cannot derive a branch name from bead '$bead'" >&2
		return 2
	fi
	printf '%s\n' "$branch"
}

# Sets the caller's `bead`, `beads_dir`, `verified`, `delivered`, `approved`,
# `head_sha`, `pr`, `repo`, `pr_url` and `since` locals from the flag of the
# same name, accepting only the flags named in the space-separated list $1.
# Returns 2 on any other flag or a flag with no value after it.
parse_flags() {
	local accepted=" $1 "
	shift
	while [ $# -gt 0 ]; do
		[ $# -ge 2 ] || { echo "slice-wave: $1 needs a value" >&2; return 2; }
		case "$accepted" in
			*" $1 "*) ;;
			*) echo "slice-wave: unknown flag $1" >&2; return 2 ;;
		esac
		case "$1" in
			--bead) bead="$2" ;;
			--beads-dir) beads_dir="$2" ;;
			--verified) verified="$2" ;;
			--delivered) delivered="$2" ;;
			--approved) approved="$2" ;;
			--head-sha) head_sha="$2" ;;
			--pr) pr="$2" ;;
			--repo) repo="$2" ;;
			--pr-url) pr_url="$2" ;;
			--since) since="$2" ;;
		esac
		shift 2
	done
}

# Puts the current worktree on the branch derived from $1, creating it if
# refs/heads/<branch> does not exist yet. Already being on it is a no-op.
# git's own error reaches stderr, since a dirty tree and a branch held by
# another worktree need different fixes.
switch_to_branch() {
	local branch="$1"
	if git show-ref --verify --quiet "refs/heads/$branch"; then
		git switch --quiet "$branch"
	else
		git switch --quiet -c "$branch"
	fi
}

# Fails a claim on a target repository that cannot host the pull request the
# rest of the pipeline exists to open: no forge remote claim can push a
# branch to and have write access on, checked with `gh` in the cwd. Runs
# before any branch switch or bd call, so a refusal here leaves the worktree
# exactly where it started.
check_target_forge() {
	local view perm
	if ! view="$(gh repo view --json nameWithOwner,viewerPermission 2>&1)"; then
		echo "slice-wave: no forge remote you can open pull requests on (add a GitHub remote you can push to, then check 'gh auth status'). gh said: $view" >&2
		return 1
	fi

	perm="$(printf '%s' "$view" | jq -r '.viewerPermission // empty' 2>/dev/null)"
	case "$perm" in
		ADMIN | MAINTAIN | WRITE) return 0 ;;
	esac
	echo "slice-wave: no forge remote you can open pull requests on (viewer permission is $perm; add a GitHub remote you can push to, then check 'gh auth status')" >&2
	return 1
}

# Fails a claim on a target repository whose origin git itself cannot push
# $1 to. no-mistakes pushes the branch to origin's URL with git's own
# credential, which can belong to a different account than the one gh
# checked in check_target_forge. Runs before any branch switch or bd call,
# same as check_target_forge.
check_target_push() {
	local branch="$1" said
	# --force so a stale remote slice branch that HEAD does not contain reads
	# as pushable; --dry-run writes nothing, so forcing costs nothing.
	# --no-verify because a dry run still fires the target's pre-push hook,
	# whose tests or lint say nothing about the credential.
	said="$(git push --dry-run --no-verify --force --quiet origin "HEAD:refs/heads/$branch" 2>&1)" || {
		echo "slice-wave: git cannot push to origin (check the git credential for origin's URL, which is separate from gh's). git said: $said" >&2
		return 1
	}
}

# Fails a claim on a target repository no-mistakes cannot validate: `axi`
# (the home view) is the cheapest call that proves the gate is initialized,
# and it starts no run. Runs before any branch switch or bd call, same as
# check_target_forge.
check_target_no_mistakes() {
	local home rc error_line
	home="$(no-mistakes axi 2>&1)"
	rc=$?
	error_line="$(printf '%s\n' "$home" | grep '^error:' | head -1)"
	if [ "$rc" -ne 0 ] || [ -n "$error_line" ]; then
		echo "slice-wave: no-mistakes is not ready on this target; run 'no-mistakes init'. ${error_line:-$home}" >&2
		return 1
	fi
}

# Strips the double quotes TOON puts around a value that needs them, e.g. an
# empty string or one containing a colon, and undoes its escapes (see
# toon_quoted). Plain barewords like a next_action code or an ordinary shell
# command pass through unchanged, as does a quoted value that never closes.
toon_unquote() {
	local s="$1" field rest
	case "$s" in
		\"*\")
			rest="${s:1}"
			if toon_quoted && [ -z "$rest" ]; then
				s="$field"
			fi
			;;
	esac
	printf '%s' "$s"
}

# Decodes the TOON quoted string the caller's `rest` opens with, its opening
# quote already stripped, into the caller's `field`, and leaves in `rest`
# whatever follows the closing quote. `\"`, `\\`, `\n`, `\r` and `\t` are
# TOON's escapes and a bare `"` closes the string. Returns 1 when the string
# never closes.
toon_quoted() {
	field=""
	while :; do
		# shellcheck disable=SC1003 # '\\' is a literal two-backslash TOON escape
		case "$rest" in
			'\"'*) field="$field\""; rest="${rest:2}" ;;
			'\\'*) field="$field\\"; rest="${rest:2}" ;;
			'\n'*) field="$field"$'\n'; rest="${rest:2}" ;;
			'\r'*) field="$field"$'\r'; rest="${rest:2}" ;;
			'\t'*) field="$field"$'\t'; rest="${rest:2}" ;;
			'"'*) rest="${rest:1}"; return 0 ;;
			'') return 1 ;;
			*) field="$field${rest:0:1}"; rest="${rest:1}" ;;
		esac
	done
}

# Detaches HEAD the same way a refused claim always has: a failure past this
# point must not leave the worktree squatting on $1, since that would block
# every retry's switch. A failed detach only warns, since a worktree stuck on
# the branch is the worse outcome next to a missing warning.
detach_worktree() {
	local branch="$1"
	git switch --quiet --detach || echo "slice-wave: cannot detach, so $branch stays checked out here" >&2
}

# Reads no-mistakes' cached branch_sync state before any local commit and, if
# it names a sync to run, runs it and re-reads before claiming. A slice
# dispatched again after a failed validation can land on a branch no-mistakes
# already pushed fix commits to, so this has to see that before the build step
# commits again. Runs after the branch switch: it is reading this branch's
# custody, not the one this worktree started on.
#
# Never runs anything besides one of the `no-mistakes axi sync` forms
# no-mistakes reports, matched exactly and run as argv. An unrecognised code,
# any other reported command, or a sync that fails, all stop here and leave
# the recovery to no-mistakes or a human, per its own custody rules. The
# caller detaches on failure.
reconcile_branch_sync() {
	local branch="$1" rounds=0 status rc error_line code command output
	while :; do
		status="$(no-mistakes axi status 2>&1)"
		rc=$?
		error_line="$(printf '%s\n' "$status" | grep '^error:' | head -1)"
		if [ "$rc" -ne 0 ] || [ -n "$error_line" ]; then
			echo "slice-wave: cannot read no-mistakes axi status for $branch. ${error_line:-$status}" >&2
			return 1
		fi
		code="$(toon_value "$status" branch_sync.next_action.code)"
		command="$(toon_value "$status" branch_sync.next_action.command)"

		case "$code" in
			"" | run_pipeline) return 0 ;;
			sync | check_sync | retry | recover_custody)
				case "$command" in
					"no-mistakes axi sync" | "no-mistakes axi sync --check" | \
						"no-mistakes axi sync --recover" | "no-mistakes axi sync --recover --keep-local") ;;
					*)
						echo "slice-wave: no-mistakes reported $code with command '$command' on $branch, which is not a sync command; refusing to run it" >&2
						return 1
						;;
				esac
				if [ "$rounds" -ge 3 ]; then
					echo "slice-wave: no-mistakes still reports $code on $branch after 3 sync attempts" >&2
					return 1
				fi
				# shellcheck disable=SC2086 # an allowlisted flag list, split into argv on purpose
				if ! output="$(no-mistakes axi sync ${command#no-mistakes axi sync} 2>&1)"; then
					echo "slice-wave: '$command' failed while reconciling $branch. $output" >&2
					return 1
				fi
				rounds=$((rounds + 1))
				;;
			*)
				echo "slice-wave: no-mistakes reports $code (command: $command) on $branch, which claim does not know how to reconcile" >&2
				return 1
				;;
		esac
	done
}

cmd_claim() {
	local bead="" beads_dir=""
	parse_flags "--bead --beads-dir" "$@" || return 2
	[ -n "$bead" ] && [ -n "$beads_dir" ] || {
		echo "slice-wave: claim needs --bead and --beads-dir" >&2
		return 2
	}

	local branch
	branch="$(derive_branch "$bead")" || {
		echo "slice-wave: cannot derive a branch name from bead '$bead'" >&2
		return 2
	}

	# Built before the switch and the claim, so a failure here strands neither
	# a checked-out branch nor a claimed bead.
	local claimed
	claimed="$(jq -n --arg bead "$bead" --arg beads_dir "$beads_dir" --arg branch "$branch" \
		'{bead: $bead, beads_dir: $beads_dir, branch: $branch}')" || {
		echo "slice-wave: cannot build the claim output, so $bead was not claimed" >&2
		return 1
	}

	check_target_forge || return 1
	check_target_push "$branch" || return 1
	check_target_no_mistakes || return 1

	switch_to_branch "$branch" || {
		echo "slice-wave: cannot switch to $branch" >&2
		return 1
	}

	reconcile_branch_sync "$branch" || {
		detach_worktree "$branch"
		return 1
	}

	# Detaches on refusal because release never runs after a failed claim, and
	# a kept worktree still on the branch would block every retry's switch.
	# It also keeps verify-commit from crediting a branch this run never claimed.
	BEADS_DIR="$beads_dir" bd update "$bead" --claim >/dev/null || {
		echo "slice-wave: tracker refused to claim $bead" >&2
		detach_worktree "$branch"
		return 1
	}

	printf '%s\n' "$claimed"
}

# Detaches first: Archon keeps a finished run's worktree, and while it still
# has the slice branch checked out, a retry's claim cannot switch to it. A
# failed detach does not stop the unclaim, because a bead left claimed by a
# gone worker is the worse outcome. `bd unclaim` refuses to clear a claim
# held by a different actor.
cmd_release() {
	local bead="" beads_dir=""
	parse_flags "--bead --beads-dir" "$@" || return 2
	[ -n "$bead" ] && [ -n "$beads_dir" ] || {
		echo "slice-wave: release needs --bead and --beads-dir" >&2
		return 2
	}

	git switch --quiet --detach || echo "slice-wave: cannot detach, so the slice branch stays checked out here" >&2

	BEADS_DIR="$beads_dir" bd unclaim "$bead" >/dev/null || {
		echo "slice-wave: tracker refused to release $bead" >&2
		return 1
	}

	printf '%s\n' '{"released":true}'
}

# True when $1 is a test file: a path component named test/tests/spec/specs/
# __tests__ or ending in .Test/.Tests, a basename containing .test./.spec./
# _test./_spec./Test./Tests., a basename starting test_, or one ending in
# .bats. One-sided by design: nothing requires a non-test file to have changed
# too, since a tests-only slice is legitimate work.
is_test_path() {
	local base="${1##*/}"
	case "$base" in
		*.bats | *.test.* | *.spec.* | *_test.* | *_spec.* | test_* | *Test.* | *Tests.*) return 0 ;;
	esac
	# Sentinel slashes so the first and last components match the same pattern
	# as the interior ones. Matching on the whole path avoids splitting it into
	# words, which would glob-expand a path containing [ or *.
	case "/$1/" in
		*/test/* | */tests/* | */spec/* | */specs/* | */__tests__/* | *.Test/* | *.Tests/*) return 0 ;;
	esac
	return 1
}

# Reads every line before returning, deliberately. Returning early would leave
# the producer writing into a closed pipe, and with `pipefail` the SIGPIPE
# becomes the pipeline's status, reading a found test file as "none found" on
# any diff whose path list outgrows the pipe buffer.
any_test_path() {
	local path found=1
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		is_test_path "$path" && found=0
	done
	return "$found"
}

# Prints, as a JSON array, every lint waiver whose spend record names the tree
# of a commit in $1..$2. The personal coding-standards gate keys each spend on
# the index tree it let through, so this reads what the commit actually used
# rather than what the build agent says it used. An unattended build records a
# waiver without asking, and this list is where Trevor reviews it after merge.
# An absent log is no waivers; an unreadable one prints nothing and returns 1.
spent_waivers() {
	local log="${TVRMSMITH_WAIVERS:-${XDG_STATE_HOME:-$HOME/.local/state}/coding-standards/waivers.jsonl}"
	[ -e "$log" ] || { echo "[]"; return 0; }
	local trees
	trees="$(git log --format=%T "$1..$2" | jq -Rn '[inputs]')" || return 1
	jq -cs --argjson trees "$trees" '
		([.[] | select(.kind == "spend" and (.tree | IN($trees[]))) | .id] | unique) as $ids
		| [.[] | select(.kind == "waiver" and (.id | IN($ids[])))
		  | {id, language, path, rule, reason}]' "$log"
}

cmd_verify_commit() {
	local bead="" beads_dir=""
	parse_flags "--bead --beads-dir" "$@" || return 2

	local branch
	branch="$(derive_branch "$bead")" || {
		echo "slice-wave: cannot derive a branch name from bead '$bead'" >&2
		return 2
	}

	# origin/HEAD first: it names the branch a slice lands on, even where the
	# local main is stale or the default branch has another name.
	local resolved_base="" candidate
	for candidate in origin/HEAD origin/main main; do
		git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1 || continue
		resolved_base="$candidate"
		break
	done

	local committed=false tests_touched=false verified=false sha="" reason="" count paths waivers="[]" waivers_error=""
	if [ -z "$resolved_base" ]; then
		reason="cannot resolve a base ref"
	elif ! git show-ref --verify --quiet "refs/heads/$branch"; then
		reason="no branch $branch"
	elif [ "$(git symbolic-ref --quiet --short HEAD)" != "$branch" ]; then
		reason="this worktree is not on $branch, so this run never claimed it"
	elif ! count="$(git rev-list --count "$resolved_base..$branch" 2>&1)"; then
		reason="cannot count commits on $branch: $count"
	elif [ "$count" -eq 0 ]; then
		reason="no commit on $branch beyond $resolved_base"
	else
		committed=true
		sha="$(git rev-parse "$branch")"
		waivers="$(spent_waivers "$resolved_base" "$branch")" || {
			waivers="[]"
			waivers_error="cannot read the waiver log, so the waivers behind $branch are unknown"
		}
		if ! paths="$(git diff --name-only "$resolved_base...$branch" 2>&1)"; then
			reason="cannot list the files changed on $branch: $paths"
		elif printf '%s\n' "$paths" | any_test_path; then
			tests_touched=true
			verified=true
		else
			reason="no test file in the commits on $branch"
		fi
	fi

	jq -n --arg branch "$branch" --arg sha "$sha" --arg reason "$reason" \
		--argjson committed "$committed" --argjson tests_touched "$tests_touched" \
		--argjson verified "$verified" --argjson waivers "$waivers" \
		--arg waivers_error "$waivers_error" \
		'{verified: $verified, committed: $committed, tests_touched: $tests_touched,
		  branch: $branch, sha: $sha, reason: $reason, waivers: $waivers,
		  waivers_error: $waivers_error}'
	return 0
}

# Prints the value no-mistakes' TOON $1 gives the dotted key path $2,
# unquoted, or nothing when it is absent. TOON nests two spaces per level, and
# a line starts a block only when nothing follows its colon, so each segment
# but the last names a block header at its depth and the last names a
# `key: value` line one level inside it. Leaving a block before the key shows
# up means the key is absent.
toon_value() {
	local input="$1" path="$2" raw
	raw="$(awk -v path="$path" '
		BEGIN { n = split(path, seg, "."); depth = 1; indent = "" }
		depth > 1 && index($0, indent) != 1 { exit }
		depth < n && $0 == indent seg[depth] ":" { depth++; indent = indent "  "; next }
		depth == n && index($0, indent seg[n] ": ") == 1 { print substr($0, length(indent seg[n]) + 3); exit }
	' <<<"$input")"
	toon_unquote "$raw"
}

# Prints each row of the TOON `fixes[N]{step,summary}:` table in $1 as
# `step: summary`, one per line, nothing when the run fixed nothing.
toon_fixes() {
	local input="$1" row
	awk '
		/^fixes\[[0-9]+\]\{step,summary\}:$/ { inside = 1; next }
		inside && /^  / { print substr($0, 3); next }
		inside { exit }
	' <<<"$input" | while IFS= read -r row; do
		printf '%s: %s\n' "${row%%,*}" "$(toon_unquote "${row#*,}")"
	done
}

# Splits one row of a TOON tabular table into its fields, printed joined by
# $FINDING_HISTORY_SEP and ended by $FINDING_HISTORY_RS, quoting and
# backslash-escapes undone. A naive split on `,` breaks on a quoted field that
# itself contains a comma, colon or escaped quote (TOON's own reason for
# quoting it), so this walks the row instead: toon_quoted reads a quoted
# field, and outside one, `,` ends the field. Prints nothing for a row that
# does not split into exactly $2 fields with a non-empty first one, or whose
# quoted field never closes or runs into text before the next `,`.
toon_row_fields() {
	local rest="$1" want="$2" field out="" sep="" count=0
	while :; do
		if [ "${rest:0:1}" = '"' ]; then
			rest="${rest:1}"
			toon_quoted || return 0
		else
			field="${rest%%,*}"
			rest="${rest:${#field}}"
		fi
		[ "$count" -gt 0 ] || [ -n "$field" ] || return 0
		out="$out$sep$field"
		sep="$FINDING_HISTORY_SEP"
		count=$((count + 1))
		case "$rest" in
			,*) rest="${rest:1}" ;;
			'') break ;;
			*) return 0 ;;
		esac
	done
	[ "$count" -eq "$want" ] || return 0
	printf '%s%s' "$out" "$FINDING_HISTORY_RS"
}

# The field separator toon_finding_history joins on. Not a tab: bash `read`
# treats IFS whitespace (space, tab, newline) as a run that collapses and
# trims, which would silently drop an empty field such as a row with no file.
# 0x1F (ASCII unit separator) is not IFS whitespace, so an empty field between
# two of them survives both the awk join and the caller's `read`.
FINDING_HISTORY_SEP="$(printf '\037')"
readonly FINDING_HISTORY_SEP

# The record separator toon_finding_history ends each row with. Not a
# newline, since a description's decoded `\n` escape is one. 0x1E is ASCII
# record separator.
FINDING_HISTORY_RS="$(printf '\036')"
readonly FINDING_HISTORY_RS

# The finding_history columns validate reads, in the order no-mistakes sends
# them. A table under any other header is one validate cannot read.
FINDING_HISTORY_COLUMNS="step,round,id,severity,action,source,selected,file,line,description"
readonly FINDING_HISTORY_COLUMNS

# Prints each row of the TOON finding_history table in $1, whose header
# history_state_of has already checked names $FINDING_HISTORY_COLUMNS, each
# row ended by $FINDING_HISTORY_RS with its columns joined by
# $FINDING_HISTORY_SEP in that order, quoting and escapes undone. A row that
# does not parse prints nothing.
toon_finding_history() {
	local input="$1" row width
	width="$(awk -F, '{ print NF }' <<<"$FINDING_HISTORY_COLUMNS")"
	awk '
		/^finding_history\[[0-9]+\]\{/ { inside = 1; next }
		inside && /^  / { print substr($0, 3); next }
		inside { exit }
	' <<<"$input" | while IFS= read -r row; do
		toon_row_fields "$row" "$width"
	done
}

# Sets the caller's `history_state` from no-mistakes' TOON $1 to one of:
#   rows    finding_history has $FINDING_HISTORY_COLUMNS under its header;
#           `history_count` carries its row count, read them with
#           toon_finding_history
#   empty   finding_history[0]: - the run found nothing
#   error   finding_history_error is set, or the header names other columns;
#           `history_error` carries the reason
#   absent  no finding_history key beside an outcome - an older no-mistakes
#           never sent it
#   unfinished  no finding_history key and no outcome - no-mistakes sends the
#           history only with a final result
history_state_of() {
	local input="$1" header
	history_error="$(toon_value "$input" finding_history_error)"
	header="$(grep -m 1 '^finding_history\[' <<<"$input")"
	history_count="${header#finding_history[}"
	history_count="${history_count%%]*}"
	if [ -n "$history_error" ]; then
		history_state=error
	elif [ -z "$header" ] && [ -n "$(toon_value "$input" outcome)" ]; then
		history_state=absent
	elif [ -z "$header" ]; then
		history_state=unfinished
	elif [ "$header" = 'finding_history[0]:' ]; then
		history_state=empty
	elif [ "$header" = "finding_history[$history_count]{$FINDING_HISTORY_COLUMNS}:" ]; then
		history_state=rows
	else
		history_state=error
		history_error="unrecognised finding_history columns: $header"
	fi
}

# Prints the findings-history part of the record from no-mistakes' TOON $1:
# every ask-user finding verbatim plus a per-step tally of every finding when
# the run carries a history, or one of the sentences standing in for a
# history validate could not read, found empty, an older no-mistakes never
# sent, or a run with no final result has yet to send.
findings_history_section() {
	local toon="$1" history_state history_error="" history_count rows
	history_state_of "$toon"
	if [ "$history_state" = rows ]; then
		rows="$(toon_finding_history "$toon")"
		if [ "$(printf '%s' "$rows" | tr -cd "$FINDING_HISTORY_RS" | wc -c | tr -d ' ')" != "$history_count" ]; then
			history_state=error
			history_error="finding_history declares $history_count rows but validate could not read them all"
		fi
	fi
	case "$history_state" in
		error)
			printf 'Findings history: unknown (%s)\n' "$history_error"
			return
			;;
		empty)
			printf 'Findings history: none\n'
			return
			;;
		absent)
			printf '%s\n' 'This no-mistakes version does not expose findings history, so this record lists only what it reports at the end of the run.'
			return
			;;
		unfinished)
			printf 'Findings history: not available, no-mistakes sends it only with a final result\n'
			return
			;;
	esac

	local step round id severity action file line description loc ask_line ask_lines=""
	while IFS="$FINDING_HISTORY_SEP" read -r -d "$FINDING_HISTORY_RS" step round id severity action _ _ file line description; do
		[ "$action" = ask-user ] || continue
		loc="$file"
		if [ -n "$line" ] && [ "$line" != 0 ]; then
			loc="${loc:+$loc:}$line"
		fi
		printf -v ask_line -- '- %s round %s %s %s%s: %s\n' \
			"$step" "$round" "$id" "$severity" "${loc:+ $loc}" "$description"
		ask_lines="${ask_lines}${ask_line}"
	done <<<"$rows"

	if [ -n "$ask_lines" ]; then
		printf 'Ask-user findings:\n%s' "$ask_lines"
	else
		printf 'Ask-user findings: none\n'
	fi

	printf '\nAll findings:\n'
	printf '%s' "$rows" | awk -F"$FINDING_HISTORY_SEP" -v RS="$FINDING_HISTORY_RS" '
		{
			step = $1
			if (!(step in seen)) { seen[step] = 1; order[n++] = step }
			count[step]++
			detail[step] = detail[step] (detail[step] == "" ? "" : ", ") \
				$3 " " ($7 == "true" ? "selected" : "not selected")
		}
		END {
			for (i = 0; i < n; i++) {
				step = order[i]
				plural = (count[step] == 1) ? "finding" : "findings"
				printf "- %s: %d %s (%s)\n", step, count[step], plural, detail[step]
			}
		}
	'
}

# Prints bd's record of bead $1 as the one intent text no-mistakes takes:
# every non-empty field a slice's goal lives in, separated by blank lines.
# Prints nothing when every field is empty.
bead_intent() {
	local bead="$1" beads_dir="$2" show
	show="$(BEADS_DIR="$beads_dir" bd show "$bead" --json)" || return 1
	printf '%s' "$show" | jq -r '.[0]
		| [.title, .description, .design, .acceptance_criteria, .notes]
		| map(select(. != null and . != "")) | join("\n\n")'
}

# Drives one no-mistakes run of the current branch to its end under --yes and
# prints the TOON of how it ended. Never reruns, rebases, merges or closes
# anything: recovering a dead run is custody no-mistakes or a human owns.
#
# A drive holds for a bounded wait, then returns an `elapsed` error while the
# run carries on. Reattaching omits --intent on purpose: passed when no run is
# active, it starts a new one. So a reattach refused for want of an intent
# means the run ended between calls, and its outcome is read from status: by
# the last run id seen, else the branch's latest run, since an elapsed error
# carries no run block.
#
# Stops reattaching once $SLICE_WAVE_DRIVE_LIMIT_SECONDS (3.5 hours) have
# passed since validate started, prints the last TOON and returns 1, leaving
# the run to carry on. That keeps validate reporting ahead of its node's 4 h
# timeout, whose kill would persist no outcome and so skip merge and release.
drive_run() {
	local intent="$1" toon run_id="" id limit="${SLICE_WAVE_DRIVE_LIMIT_SECONDS:-12600}"
	toon="$(no-mistakes axi run --yes --intent "$intent" 2>&1)"
	while :; do
		id="$(toon_value "$toon" run.id)"
		[ -z "$id" ] || run_id="$id"
		case "$(toon_value "$toon" error)" in
			*"elapsed while driving the run"*)
				if [ "$SECONDS" -ge "$limit" ]; then
					printf '%s\n' "$toon"
					return 1
				fi
				toon="$(no-mistakes axi run --yes 2>&1)"
				;;
			*"--intent is required"*)
				if [ -n "$run_id" ]; then
					toon="$(no-mistakes axi status --run "$run_id" 2>&1)"
				else
					toon="$(no-mistakes axi status 2>&1)"
				fi
				break
				;;
			*) break ;;
		esac
	done
	printf '%s\n' "$toon"
}

# Prints why the drive whose final TOON is $1 and outcome $2 stopped short of
# an outcome, or failed with one: a gate --yes cannot pass, an error, or
# output carrying neither. Prints nothing for a clean outcome.
run_problem() {
	local toon="$1" outcome="$2" step error
	step="$(toon_value "$toon" gate.step)"
	error="$(toon_value "$toon" error)"
	if [ -n "$step" ]; then
		printf 'no-mistakes stopped at the %s gate: %s\n' "$step" "$(toon_value "$toon" gate.summary)"
	elif [ -n "$error" ]; then
		printf 'no-mistakes reported: %s\n' "$error"
	elif [ -z "$outcome" ]; then
		printf 'no-mistakes reported no outcome: %s\n' "$(printf '%s\n' "$toon" | head -1)"
	fi
}

# True when no-mistakes outcome $1 is green: checks-passed from a live drive,
# or passed, which a finished run's status reports for a run whose CI step
# completed cleanly. Overrides, automatic skips and an interrupted monitor
# all fall short.
green_outcome() {
	case "$1" in
		checks-passed | passed) return 0 ;;
	esac
	return 1
}

# Appends $1 to the caller's `reason`, joining several with "; ".
add_reason() {
	reason="${reason:+$reason; }$1"
}

# Sets the caller's pr_number and pr_url from the one open pull request gh
# lists in repo $1 for the current branch. Zero or several add a reason
# instead, since commenting on a guess would file the record on the wrong PR.
find_open_pr() {
	local repo="$1" branch prs count
	branch="$(git symbolic-ref --quiet --short HEAD)" || {
		add_reason "HEAD is detached, so no pull request could be looked up and no findings record was posted"
		return
	}
	if ! prs="$(gh pr list --head "$branch" --state open --json number,url -R "$repo")" ||
		! count="$(printf '%s' "$prs" | jq length)"; then
		add_reason "cannot list the open pull requests for $branch, so no findings record was posted"
		return
	fi
	case "$count" in
		1)
			pr_number="$(printf '%s' "$prs" | jq -r '.[0].number')"
			pr_url="$(printf '%s' "$prs" | jq -r '.[0].url')"
			;;
		0) add_reason "no open pull request for $branch, so no findings record was posted" ;;
		*) add_reason "$count open pull requests for $branch, so no findings record was posted" ;;
	esac
}

# Prints the markdown comment that records a drive on its pull request, from
# the outcome $1, the fix count $2 and its `step: summary` lines $3, the
# outstanding findings $4, the error or gate text $5, and the run's full TOON
# $6, whose finding_history closes the record (see findings_history_section).
findings_record() {
	local outcome="$1" fix_rounds="$2" fixes="$3" findings="$4" problem="$5" toon="$6"
	printf '%s\n' '<!-- slice-pipeline:findings-record -->' '## slice-pipeline findings record' ''
	printf 'Drive mode: yes\nOutcome: %s\nFix rounds: %s\n' "${outcome:-none reported}" "$fix_rounds"
	[ -z "$fixes" ] || printf '%s\n' "$fixes" | sed 's/^/- /'
	printf '\nOutstanding findings: %s\n' "${findings:-none reported}"
	[ -z "$problem" ] || printf '\nError: %s\n' "$problem"
	printf '\n'
	findings_history_section "$toon"
}

# Sets the caller's outcome, pr_number, pr_url, repo, fix_rounds,
# record_posted and reason locals from one no-mistakes drive of bead $1's
# committed slice, and posts the findings record on its pull request.
validate_slice() {
	local bead="$1" beads_dir="$2" intent toon problem="" fixes findings still_running=false
	intent="$(bead_intent "$bead" "$beads_dir")" || {
		add_reason "cannot read bead $bead with bd show, so no-mistakes never ran"
		return
	}
	[ -n "$intent" ] || {
		add_reason "bead $bead has no title, description, design, acceptance criteria or notes to give no-mistakes as its intent, so no-mistakes never ran"
		return
	}

	toon="$(drive_run "$intent")" || still_running=true
	outcome="$(toon_value "$toon" outcome)"
	fixes="$(toon_fixes "$toon")"
	[ -z "$fixes" ] || fix_rounds="$(printf '%s\n' "$fixes" | wc -l | tr -d ' ')"
	findings="$(toon_value "$toon" run.findings)"
	if [ "$still_running" = true ]; then
		problem="the no-mistakes drive was still running when validate reached its time limit, so it was left to carry on"
	else
		problem="$(run_problem "$toon" "$outcome")"
	fi
	if [ -n "$problem" ]; then
		add_reason "$problem"
	elif ! green_outcome "$outcome"; then
		add_reason "no-mistakes ended $outcome, not checks-passed or passed"
	fi

	# The run's PR URL names its own repo, which in a fork checkout can differ
	# from the one gh resolves by default, so gh repo view is only the fallback.
	pr_url="$(toon_value "$toon" run.pr)"
	case "${pr_url##*/pull/}" in
		"" | *[!0-9]*) ;;
		*)
			pr_number="${pr_url##*/pull/}"
			repo="${pr_url#*://*/}"
			repo="${repo%/pull/*}"
			;;
	esac

	if [ "$pr_number" -eq 0 ]; then
		repo="$(gh repo view --json nameWithOwner | jq -r '.nameWithOwner // empty')" || repo=""
		[ -n "$repo" ] || {
			add_reason "gh repo view named no repository, so no findings record was posted"
			return
		}
		find_open_pr "$repo"
		[ "$pr_number" -gt 0 ] || return
	fi

	if findings_record "$outcome" "$fix_rounds" "$fixes" "$findings" "$problem" "$toon" \
		| gh pr comment "$pr_url" --body-file - >/dev/null; then
		record_posted=true
	else
		add_reason "cannot post the findings record on pull request $pr_url"
	fi
}

# The workflow's returns node runs on this output on every path, so once
# --verified is true or false it exits 0 on every path and reports through the
# JSON object, never through its exit status.
cmd_validate() {
	local bead="" beads_dir="" verified=""
	parse_flags "--bead --beads-dir --verified" "$@" || { usage; return 2; }
	[ -n "$bead" ] && [ -n "$beads_dir" ] && [ -n "$verified" ] || {
		echo "slice-wave: validate needs --bead, --beads-dir and --verified" >&2
		usage
		return 2
	}

	local outcome="" pr_number=0 pr_url="" repo="" fix_rounds=0 record_posted=false reason=""
	case "$verified" in
		true) validate_slice "$bead" "$beads_dir" ;;
		false) reason="verification did not pass, so validation was skipped" ;;
		*)
			echo "slice-wave: --verified must be true or false, not '$verified'" >&2
			usage
			return 2
			;;
	esac

	local delivered=false
	green_outcome "$outcome" && [ "$pr_number" -gt 0 ] && [ "$record_posted" = true ] && delivered=true
	jq -n --argjson delivered "$delivered" --arg outcome "$outcome" \
		--argjson pr_number "$pr_number" --arg pr_url "$pr_url" --arg repo "$repo" \
		--argjson fix_rounds "$fix_rounds" --argjson record_posted "$record_posted" \
		--arg reason "$reason" \
		'{delivered: $delivered, outcome: $outcome, pr_number: $pr_number,
		  pr_url: $pr_url, repo: $repo, fix_rounds: $fix_rounds,
		  record_posted: $record_posted, reason: $reason}'
	return 0
}

# True when $1 is a full commit id as gh and tuicr print one: 40 lowercase
# hex digits.
is_commit_sha() {
	[ "${#1}" -eq 40 ] && case "$1" in *[!0-9a-f]*) false ;; esac
}

# Sets the caller's `strategy` to how repository $1 merges: merge-queue when
# the machine-local repos.json gives it a merge_queue of true, else squash.
# The file is machine-local because which repositories run a merge queue is a
# fact about the target, never one this repository commits. A file jq cannot
# read adds a reason and returns 1, since guessing squash could bypass a queue.
merge_strategy() {
	local repo="$1" config="${XDG_CONFIG_HOME:-$HOME/.config}/slice-pipeline/repos.json" queued
	strategy=squash
	[ -e "$config" ] || return 0
	queued="$(jq --arg repo "$repo" '.[$repo].merge_queue == true' "$config" 2>&1)" || {
		strategy=""
		add_reason "cannot read $config, so nothing was merged: $queued"
		return 1
	}
	[ "$queued" != true ] || strategy=merge-queue
}

# Sets the caller's state, queued, pr_id and pr_url from one read of pull
# request $1 in repository $2. A failed read sets read_error instead and keeps
# the last read's values. The merge-queue strategy reads through GraphQL,
# since `gh pr view --json` offers no isInMergeQueue field.
read_pr() {
	local view
	if [ "$strategy" = merge-queue ]; then
		# shellcheck disable=SC2016
		view="$(gh api graphql -f owner="${2%%/*}" -f name="${2#*/}" -F number="$1" \
			-f query='query($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { state url isInMergeQueue id } } }' \
			--jq .data.repository.pullRequest 2>&1)"
	else
		view="$(gh pr view "$1" -R "$2" --json state,url 2>&1)"
	fi || {
		read_error="$view"
		return 1
	}
	read_error=""
	state="$(jq -r .state <<<"$view" 2>/dev/null)"
	[ "$state" != MERGED ] || pr_url="$(jq -r .url <<<"$view")"
	[ "$strategy" != merge-queue ] || {
		queued="$(jq -r .isInMergeQueue <<<"$view")"
		pr_id="$(jq -r .id <<<"$view")"
	}
}

# Takes pull request $1 out of repository $2's merge queue, so the queue
# cannot land it after release hands the bead back. Auto-merge goes first,
# since an armed one would enqueue it again. Returns 1 once it has added a
# reason for each step gh refused.
dequeue_pr() {
	local said rc=0
	said="$(gh pr merge "$1" -R "$2" --disable-auto 2>&1 >/dev/null)" || {
		add_reason "gh could not disable auto-merge on pull request $1: $said"
		rc=1
	}
	[ "$queued" = true ] || return "$rc"
	# shellcheck disable=SC2016
	said="$(gh api graphql -f id="$pr_id" \
		-f query='mutation($id: ID!) { dequeuePullRequest(input: {id: $id}) { clientMutationId } }' 2>&1 >/dev/null)" || {
		add_reason "gh could not dequeue pull request $1: $said"
		rc=1
	}
	return "$rc"
}

# Sets the caller's merged, strategy, pr_url and reason locals from merging
# pull request $1 in repository $2, pinned to head commit $3. Merged is what
# the forge reports afterwards, never the merge command's exit status.
merge_pr() {
	local pr="$1" repo="$2" head_sha="$3"
	merge_strategy "$repo" || return
	# A merge queue takes no strategy flag: gh enqueues the pull request and
	# the queue branch decides how it lands. Either way the forge refuses the
	# merge once the head has moved past the commit review approved.
	local merge_args=(pr merge "$pr" -R "$repo")
	[ "$strategy" = merge-queue ] || merge_args+=(--squash)
	merge_args+=(--match-head-commit "$head_sha")
	local refused="" merge_failed=false
	refused="$(gh "${merge_args[@]}" 2>&1 >/dev/null)" || merge_failed=true

	# A merge queue, or a squash waiting on required checks, leaves the pull
	# request open for a while after gh returns, so an open read is polled
	# until $SLICE_WAVE_MERGE_LIMIT_SECONDS have passed since merge started.
	# A failed read is polled too, since the forge may only be unreachable.
	local poll="${SLICE_WAVE_MERGE_POLL_SECONDS:-30}" limit="${SLICE_WAVE_MERGE_LIMIT_SECONDS:-7200}"
	local grace="${SLICE_WAVE_MERGE_DROP_GRACE_SECONDS:-5}"
	local state="" queued=false pr_id="" read_error=""
	local seen_queued=false suspect_drop=false dequeued
	while :; do
		if read_pr "$pr" "$repo"; then
			case "$state" in
				MERGED)
					merged=true
					return
					;;
				CLOSED)
					add_reason "pull request $pr was closed without merging"
					[ "$merge_failed" = false ] || add_reason "gh could not merge it: $refused"
					return
					;;
				OPEN)
					[ "$merge_failed" = false ] || {
						add_reason "gh could not merge pull request $pr, which the forge reports open: $refused"
						return
					}
					# gh only arms auto-merge while required checks are pending, so
					# an unqueued read counts as a drop only after a queued one. The
					# queue can let go of a pull request just before it reads merged,
					# so a drop also needs a second unqueued read $grace seconds on.
					if [ "$queued" = true ]; then
						seen_queued=true
						suspect_drop=false
					elif [ "$seen_queued" = true ]; then
						[ "$suspect_drop" = false ] || {
							add_reason "the merge queue dropped pull request $pr, which the forge reports open"
							return
						}
						suspect_drop=true
						sleep "$grace"
						continue
					fi
					;;
			esac
		fi
		if [ "$SECONDS" -ge "$limit" ]; then
			if [ -n "$read_error" ]; then
				add_reason "could not read pull request $pr state: $read_error"
			elif [ "$state" = OPEN ]; then
				add_reason "pull request $pr is still open ${limit}s after merge started"
			else
				add_reason "the forge reports pull request $pr in unexpected state '$state' ${limit}s after merge started"
			fi
			[ "$merge_failed" = false ] || add_reason "gh could not merge it: $refused"
			[ "$strategy" = merge-queue ] || return
			dequeued=true
			dequeue_pr "$pr" "$repo" || dequeued=false
			if read_pr "$pr" "$repo" && [ "$state" = MERGED ]; then
				merged=true
				reason=""
				return
			fi
			[ "$dequeued" = false ] || add_reason "so it was dequeued at the deadline"
			return
		fi
		sleep "$poll"
	done
}

# The workflow's returns node, so once its flags are valid it exits 0 on
# every path and reports through the JSON object, never through its exit
# status.
cmd_merge() {
	local approved="" head_sha="" pr="" repo=""
	parse_flags "--approved --head-sha --pr --repo" "$@" || { usage; return 2; }
	case "$approved" in
		true | false) ;;
		*)
			echo "slice-wave: --approved must be true or false, not '$approved'" >&2
			usage
			return 2
			;;
	esac
	# --repo may be empty on a slice review never approved, since an
	# undelivered slice reports no repository; only a merge needs one.
	if [ -z "$pr" ] || { [ "$approved" = true ] && [ -z "$repo" ]; }; then
		echo "slice-wave: merge needs --pr and, for an approved slice, --repo" >&2
		usage
		return 2
	fi
	case "$pr" in
		*[!0-9]*)
			echo "slice-wave: --pr must be a pull request number, not '$pr'" >&2
			usage
			return 2
			;;
	esac
	if [ "$approved" = true ] && ! is_commit_sha "$head_sha"; then
		echo "slice-wave: --head-sha must be the 40-hex commit review approved, not '$head_sha'" >&2
		usage
		return 2
	fi

	local merged=false strategy="" pr_url="" reason=""
	case "$approved" in
		true)
			if [ "$pr" -eq 0 ]; then
				reason="the approved slice names no pull request, so nothing was merged"
			else
				merge_pr "$pr" "$repo" "$head_sha"
			fi
			;;
		false) reason="the slice was not approved in review, so nothing was merged" ;;
	esac

	jq -n --argjson merged "$merged" --arg strategy "$strategy" \
		--argjson pr_number "$pr" --arg pr_url "$pr_url" --arg reason "$reason" \
		'{merged: $merged, strategy: $strategy, pr_number: $pr_number,
		  pr_url: $pr_url, reason: $reason}'
	return 0
}

# Sets the caller's outcome, cursor, head_sha, comments and reason from
# watching pull request $1's tuicr session in repository $2 for a send past
# cursor $3, a `<release_count>:<session path>` pair or empty for none yet.
# Polls every $poll seconds until a send decides the round or $wait seconds
# have passed since review-round started, both the caller's.
# Returns 1, naming the state on stderr, once the pull request is not open.
wait_for_send() {
	local pr="$1" repo="$2" since="$3" slug="gh:$2/pr/$1"
	local base_count="${since%%:*}" base_path="${since#*:}"
	local pr_state pr_head count path session_head read_problem=""
	while :; do
		# A failed gh read leaves the head unknown, so this pass judges
		# nothing and the next one sees the same session again.
		if read_pr_head "$pr" "$repo"; then
			[ "$pr_state" = OPEN ] || {
				echo "slice-wave: pull request $pr is $pr_state, so review ended without a merge" >&2
				return 1
			}
			if read_session "$repo" "$slug" && judge_session "$slug"; then
				return 0
			fi
		fi
		[ "$SECONDS" -lt "$wait" ] || break
		sleep "$poll"
	done
	outcome=none
	cursor="${base_path:+$base_count:$base_path}"
	[ -z "$read_problem" ] || add_reason "$read_problem"
	reason="no send arrived within ${wait}s${reason:+; $reason}"
}

# Judges the caller's session read (count, path, session_head) against its
# baseline (base_count, base_path) and pull request head pr_head. Returns 0
# with outcome, cursor, comments and head_sha set when a send decides the
# round; otherwise moves the baseline as the read requires and returns 1,
# setting read_problem when the comments could not be read.
judge_session() {
	local slug="$1"
	if [ "$path" != "$base_path" ]; then
		# A session file the baseline does not name started after it, at
		# release 0, so every release it holds is a send to judge.
		base_path="$path"
		base_count=0
	fi
	[ "$count" -gt "$base_count" ] || return 1

	# Comments that cannot be read cannot be ruled out, so the send waits
	# for the next pass rather than counting as empty.
	local listed sent
	listed="$(tuicr review comments --session "$slug" 2>&1)" || {
		read_problem="tuicr review comments failed: $listed"
		return 1
	}
	sent="$(jq --argjson after "$base_count" --argjson upto "$count" \
		'map(select(.released_in != null and .released_in > $after and .released_in <= $upto)) | length' \
		<<<"$listed" 2>&1)" || {
		read_problem="cannot read the tuicr comments of $slug: $sent"
		return 1
	}
	cursor="$count:$path"
	if [ "$sent" -gt 0 ]; then
		outcome=comments
		comments="$sent"
		return 0
	elif [ "$session_head" = "$pr_head" ]; then
		outcome=approved
		head_sha="$session_head"
		return 0
	fi
	# An empty send on a stale head approves nothing, and the engineer sends
	# again once tuicr shows the new head.
	if [ -z "$session_head" ]; then
		add_reason "tuicr reported no head_sha for the send at release $count, so it cannot count as approval"
	else
		add_reason "the send at release $count reviewed head $session_head, not the pull request's head $pr_head"
	fi
	base_count="$count"
	return 1
}

# Sets the caller's pr_state and pr_head from pull request $1 in repository
# $2, or returns 1 with read_problem saying why gh cannot say.
read_pr_head() {
	local view
	view="$(gh pr view "$1" -R "$2" --json state,headRefOid 2>&1)" || {
		read_problem="gh pr view $1 -R $2 failed: $view"
		return 1
	}
	pr_state="$(jq -r '.state // empty' <<<"$view" 2>/dev/null)"
	pr_head="$(jq -r '.headRefOid // empty' <<<"$view" 2>/dev/null)"
	[ -n "$pr_state" ] && [ -n "$pr_head" ] || {
		read_problem="gh pr view $1 -R $2 reported no state and head: $view"
		return 1
	}
}

# Sets the caller's since to session $2's cursor in the `tuicr review list` of
# repository $1, leaving it empty when the list holds no such session. A list
# tuicr cannot give is retried every $poll seconds, since the session it hides
# may already hold releases, and returns 1 with read_problem set once $wait
# seconds have passed since review-round started.
snapshot_session() {
	local count path session_head rc
	while :; do
		rc=0
		read_session "$1" "$2" || rc=$?
		case "$rc" in
			0)
				since="$count:$path"
				return 0
				;;
			2) return 0 ;;
		esac
		[ "$SECONDS" -lt "$wait" ] || return 1
		sleep "$poll"
	done
}

# Sets the caller's count, path and session_head from session $2 in the
# `tuicr review list` of repository $1. Otherwise sets read_problem saying
# why, and returns 2 when the list read but holds no such session, or 1 when
# tuicr gave no list to read.
read_session() {
	local list session
	list="$(tuicr review list --repo "$1" 2>&1)" || {
		read_problem="tuicr review list failed: $list"
		return 1
	}
	# The path gets a line of its own, since it may hold spaces, and a head
	# absent between two IFS-whitespace separators would collapse away.
	session="$(jq -r --arg slug "$2" '
		map(select(.slug == $slug)) | first
		| if . == null then empty
		  elif (.release_count | type) == "number" and (.release_count | floor) == .release_count
		    and (.path | type) == "string"
		  then "\(.release_count) \(.head_sha // "")\n\(.path)"
		  else error("session \($slug) carries no whole release_count and path") end' <<<"$list" 2>&1)" || {
		read_problem="cannot read the tuicr review list: $session"
		return 1
	}
	[ -n "$session" ] || {
		read_problem="tuicr has no review session $2"
		return 2
	}
	read_problem=""
	{
		read -r count session_head
		IFS= read -r path
	} <<<"$session"
}

# Opens the review tab titled $3 in Orca, running tuicr on pull request $1
# of repository $2, unless a tab of that title is already open.
ensure_review_tab() {
	local pr="$1" repo="$2" title="$3" terminals main registered worktree="" candidate
	terminals="$(orca_json terminal list --json --include-visual-layouts)" || return 1
	# Only the tab title counts: a program in the pane can overwrite the
	# terminal's own. A split nests groups, so tabs are searched at any depth.
	jq -e --arg title "$title" \
		'[.result.visualLayouts[]?.root | .. | objects | .tabs? | arrays | .[].title] | index($title) != null' \
		<<<"$terminals" >/dev/null && return 0

	main="$(git worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }')"
	main="$(cd "$main" && pwd -P)"
	registered="$(orca_json repo list --json)" || return 1
	while IFS= read -r candidate; do
		[ "$(cd "$candidate" 2>/dev/null && pwd -P)" = "$main" ] || continue
		worktree="$candidate"
		break
	done < <(jq -r '.result.repos[]?.path // empty' <<<"$registered")
	if [ -z "$worktree" ]; then
		orca_json repo add --path "$main" --json >/dev/null || return 1
		worktree="$main"
	fi
	local created
	created="$(orca_json terminal create --worktree "path:$worktree" --title "$title" \
		--command "tuicr pr $repo#$pr" --json)" || return 1
	# The tab appearing is the engineer's only notice, so one Orca could not
	# show fails review rather than waiting on a send nobody knows to make.
	jq -e '.result.terminal.surface == "visible"' <<<"$created" >/dev/null || {
		echo "slice-wave: orca opened the review tab but did not show it, so nobody would know to review. orca said: $created" >&2
		return 1
	}
}

# Runs `orca "$@"` and prints its JSON, or names the failure and orca's
# output on stderr and returns 1 when orca exits non-zero or its envelope's
# .ok is not true.
orca_json() {
	local said
	if ! said="$(orca "$@" 2>&1)" || ! jq -e '.ok == true' <<<"$said" >/dev/null 2>&1; then
		echo "slice-wave: orca $1 $2 failed, so no review tab opened. orca said: $said" >&2
		return 1
	fi
	printf '%s\n' "$said"
}

# True when $1 is empty or a `<release_count>:<session path>` cursor. The
# count ends at the first colon, since the path may hold more.
is_cursor() {
	case "$1" in
		"") return 0 ;;
		*:*) ;;
		*) return 1 ;;
	esac
	case "${1%%:*}" in
		"" | *[!0-9]*) return 1 ;;
	esac
}

# Opens the review tab for a delivered slice's pull request and waits for
# the engineer to send from it. The workflow's review loop reads this output
# on every path, so once its flags are valid it reports through the JSON
# object rather than its exit status, save for the failures that end review.
cmd_review_round() {
	# Unset until parse_flags sees the flag, so the empty value the undelivered
	# path passes still counts as given. bash 3.2's bare `local` assigns an
	# empty string, hence the unset; the names stay local after it.
	local bead delivered pr repo since
	unset bead delivered pr repo since
	parse_flags "--bead --delivered --pr --repo --since" "$@" || { usage; return 2; }
	if [ -z "${bead+set}" ] || [ -z "${delivered+set}" ] || [ -z "${pr+set}" ] ||
		[ -z "${repo+set}" ] || [ -z "${since+set}" ]; then
		echo "slice-wave: review-round needs --bead, --delivered, --pr, --repo and --since" >&2
		usage
		return 2
	fi
	case "$delivered" in
		true | false) ;;
		*)
			echo "slice-wave: --delivered must be true or false, not '$delivered'" >&2
			usage
			return 2
			;;
	esac
	# Only a delivered slice has a pull request to review; the undelivered
	# path passes pr 0 and an empty repo.
	if [ "$delivered" = true ]; then
		case "$pr" in
			"" | 0 | *[!0-9]*)
				echo "slice-wave: a delivered review-round needs --pr as a pull request number, not '$pr'" >&2
				usage
				return 2
				;;
		esac
		[ -n "$repo" ] || {
			echo "slice-wave: a delivered review-round needs --repo" >&2
			usage
			return 2
		}
		is_cursor "$since" || {
			echo "slice-wave: --since must be empty or <release_count>:<session path>, not '$since'" >&2
			usage
			return 2
		}
	fi

	local outcome="" cursor="" head_sha="" comments=0 reason="" read_problem=""
	local poll="${SLICE_WAVE_REVIEW_POLL_SECONDS:-15}" wait="${SLICE_WAVE_REVIEW_WAIT_SECONDS:-28800}"
	case "$delivered" in
		true)
			# A first round baselines on the session as it stands before the
			# tab opens, so a send made in it before the first poll still counts.
			if [ -z "$since" ] && ! snapshot_session "$repo" "gh:$repo/pr/$pr"; then
				outcome=none
				reason="tuicr gave no review list to snapshot within ${wait}s, so no review tab opened: $read_problem"
			else
				ensure_review_tab "$pr" "$repo" "review $bead #$pr" || return 1
				wait_for_send "$pr" "$repo" "$since" || return 1
			fi
			;;
		false)
			outcome=undelivered
			reason="the slice was not delivered, so there is nothing to review"
			;;
	esac

	local approved=false
	[ "$outcome" != approved ] || approved=true
	jq -n --arg outcome "$outcome" --argjson approved "$approved" --arg cursor "$cursor" \
		--arg head_sha "$head_sha" --argjson comments "$comments" --arg reason "$reason" \
		'{outcome: $outcome, approved: $approved, cursor: $cursor, head_sha: $head_sha,
		  comments: $comments, reason: $reason}'
}

# Sets the caller's worktree_removed and reason locals from removing the
# linked worktree the current directory sits in. Nothing else reaps a run's
# worktree, so without this each slice leaves one behind. --force drops the
# untracked build output a run leaves, which is disposable once the code has
# merged. Archon reconciles an isolation environment whose path is gone, so
# removing it under Archon is safe. A main worktree is never removed.
remove_linked_worktree() {
	local dirs top main said
	# Both paths absolute, since git reports a main worktree's as relative.
	dirs="$(git rev-parse --path-format=absolute --git-dir --git-common-dir 2>&1)" || {
		reason="cannot tell whether this is a linked worktree, so none was removed: $dirs"
		return
	}
	[ "$(sed -n 1p <<<"$dirs")" != "$(sed -n 2p <<<"$dirs")" ] || return 0

	top="$(git rev-parse --show-toplevel)"
	main="$(git worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }')"
	if said="$(git -C "$main" worktree remove --force "$top" 2>&1)"; then
		worktree_removed=true
	else
		reason="the bead is closed but git could not remove worktree $top: $said"
	fi
}

# Closes bead $1 as merged in pull request $3, run once the forge confirms
# the merge, then removes the run's linked worktree.
cmd_close() {
	local bead="" beads_dir="" pr_url=""
	parse_flags "--bead --beads-dir --pr-url" "$@" || { usage; return 2; }
	[ -n "$bead" ] && [ -n "$beads_dir" ] && [ -n "$pr_url" ] || {
		echo "slice-wave: close needs --bead, --beads-dir and --pr-url" >&2
		usage
		return 2
	}

	local said
	said="$(BEADS_DIR="$beads_dir" bd close "$bead" --reason "merged in $pr_url" 2>&1 >/dev/null)" || {
		echo "slice-wave: the tracker refused to close bead $bead, so its worktree was left in place. bd said: $said" >&2
		return 1
	}

	local worktree_removed=false reason=""
	remove_linked_worktree
	jq -n --argjson worktree_removed "$worktree_removed" --arg reason "$reason" \
		'{closed: true, worktree_removed: $worktree_removed, reason: $reason}'
	return 0
}

case "${1:-}" in
	branch-name)
		shift
		cmd_branch_name "$@"
		exit $?
		;;
	claim)
		shift
		cmd_claim "$@"
		exit $?
		;;
	release)
		shift
		cmd_release "$@"
		exit $?
		;;
	verify-commit)
		shift
		cmd_verify_commit "$@"
		exit $?
		;;
	validate)
		shift
		cmd_validate "$@"
		exit $?
		;;
	review-round)
		shift
		cmd_review_round "$@"
		exit $?
		;;
	merge)
		shift
		cmd_merge "$@"
		exit $?
		;;
	close)
		shift
		cmd_close "$@"
		exit $?
		;;
	*)
		usage
		exit 2
		;;
esac
