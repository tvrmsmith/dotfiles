#!/usr/bin/env bash
#
# slice-wave's adapter for the imr-ship validator: `imr pr ship
# --autofix-review`. See "Validators" in slice-pipeline/README.md for the
# adapter interface.

set -uo pipefail

# Exits 1 with the reason on stderr when no `imr` is on PATH.
cmd_check() {
	command -v imr >/dev/null || {
		echo "slice-wave-validator-imr-ship: repos.json names imr-ship as this target's validator, but no imr is on PATH" >&2
		return 1
	}
}

# Prints the result object of one `imr pr ship --autofix-review` of the
# committed slice. --autofix-review stops the ship before ci, so review and
# merge stay the pipeline's, and outcome reads opened once it exits 0.
#
# Any other exit is a halt or a failure, and outcome reads halted. The ship
# waits there for a person: its gates take a decision the pipeline cannot
# make, and a fresh `imr pr ship` must never restart it, so the reason names
# the resume command and where to run it. SIGTERM from slice-wave's time
# limit is passed on to imr, which handles it as it does Ctrl-C and leaves
# the ship resumable.
cmd_validate() {
	local intent="" log pid rc=0 stop outcome reason="" record
	[ "${1:-}" = --intent ] && [ $# -eq 2 ] || {
		echo "usage: slice-wave-validator-imr-ship validate --intent <text>" >&2
		return 2
	}
	intent="$2"

	log="$(mktemp)" || {
		jq -n '{outcome: "", delivered: false, reason: "cannot create a log file, so imr pr ship never ran", record: ""}'
		return 0
	}
	imr pr ship --autofix-review --plain --intent "$intent" >"$log" 2>&1 &
	pid=$!
	trap 'kill -TERM "$pid" 2>/dev/null' TERM
	wait "$pid" || rc=$?
	# A trapped TERM ends the first wait early; the second collects imr's own exit.
	if kill -0 "$pid" 2>/dev/null; then
		rc=0
		wait "$pid" || rc=$?
	fi
	stop="$(grep -E '^(stopped:|⏸|✗)' "$log" | tail -1)"
	rm -f "$log"

	if [ "$rc" -eq 0 ]; then
		outcome=opened
	else
		outcome=halted
		# shellcheck disable=SC2016 # the quotes sit inside a double-quoted string, so $stop expands
		reason="imr pr ship exited $rc${stop:+ on '$stop'}; read the halt and run 'imr pr ship --resume --autofix-review' in $PWD"
	fi
	record="$(
		printf 'Validator: imr pr ship --autofix-review\nOutcome: %s\n' "$outcome"
		[ -z "$stop" ] || printf 'Stopped on: %s\n' "$stop"
		printf '\n%s\n' "imr pr ship writes its review findings, its decisions and anything it left unfiled into this pull request's description."
	)"
	jq -n --arg outcome "$outcome" --argjson delivered "$([ "$outcome" = opened ] && echo true || echo false)" \
		--arg reason "$reason" --arg record "$record" \
		'{outcome: $outcome, delivered: $delivered, reason: $reason, record: $record}'
}

case "${1:-}" in
	check) shift; cmd_check "$@" ;;
	validate) shift; cmd_validate "$@" ;;
	*)
		echo "usage: slice-wave-validator-imr-ship <check|validate --intent <text>>" >&2
		exit 2
		;;
esac
