# Stow ignore file - files matching these patterns won't be symlinked
# Uses Perl regex syntax

# Repository metadata and documentation
^/CLAUDE\.md$
^/AGENTS\.md$
^/README\.md$
^/README$
^/LICENSE$

# Installation and scripts
^/install\.sh$

# Vendored third-party content (subtrees). Pulled into ~/.claude via
# symlinks under dot-claude/skills/, not stowed directly.
^/vendor

# Documentation
^/docs

# Non-stowed extras (browser themes, etc.)
^/extras

# Bat theme conversion scripts
^/bat-into-tokyonight

# bats suite for install.sh
^/tests

# Version control
^/\.git
^/\.gitignore$
^/\.gitmodules$

# Codex isn't used on this machine, and its live ~/.codex files (superset
# hooks, per-project trust levels) have diverged from what's here. Left tracked
# but unstowed rather than merged.
^/\.codex

# Ad-hoc backups (e.g. dot-claude/settings.json.bak) are local scratch, never
# something to link into $HOME.
.*\.bak$

# Editor and IDE
^/\.idea
^/\.vscode
^/\.DS_Store$
settings\.local\.json

# Repo-scoped Claude Code config (skills, commands) lives at .claude/
# at the repo root because Claude reads it from cwd. NOT a dotfile to
# install into ~/.claude.
^/\.claude$

# Tool state written into the repo root by agents and CLIs run from here:
# the beads issue DB, lavish HTML artifacts, orca worktree metadata,
# superpowers scratch. Repo-local working data, not config to install.
^/\.beads
^/\.lavish
^/\.orca
^/\.superpowers

# dot-agents/skills is a symlink to a directory, which stow 2.4.1 --dotfiles
# cannot descend into: it mangles the path and aborts with exit 2 *before
# linking anything at all*, making the whole install a no-op. install.sh
# recreates this one link after stow runs.
#
# Pattern is the *translated* path (.agents, not dot-agents) because this one
# is nested. Verified on stow 2.4.1, a top-level package entry matches its
# on-disk name (^/dot-alpha$ ignores it, ^/\.alpha$ does not), while a path
# below a package matches after the --dotfiles rename. So the literal dot-dirs
# above are spelled ^/\.beads etc, and dot-* packages would be spelled dot-*.
^/\.agents/skills$

# Runtime state inside otherwise-config ~/.config subdirectories: the tool that
# reads the directory also writes to it. gh rewrites hosts.yml on every
# `gh auth login` / `gh auth switch` (this repo's workflow switches account per
# directory, and several commits in the history are that write leaking back
# into the index); 1Password drops an empty telemetry-enabled marker. Patterns
# are the *translated* paths because they are nested, and install.sh's mkdir of
# both parent directories is what keeps them unfolded so these apply at all.
^/\.config/gh/hosts\.yml$
^/\.config/1Password/telemetry-enabled$

# Stow-related
^/\.stow-.*
