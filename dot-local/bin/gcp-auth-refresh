#!/bin/sh
# Idempotent ADC refresh. Run it by hand when something needs Application
# Default Credentials and they have gone stale.
#
# Nothing invokes this automatically, and nothing should. It was written for
# Claude Code's `gcpAuthRefresh` setting, which the Claude Gateway cutover on
# 2026-08-06 made inert: the provider resolves to the gateway, so none of the
# three call sites behind that setting fire. The key left dot-claude/settings.json
# on 2026-08-08 and is not coming back while the MDM gateway policy stands.
#
# The one consumer that would bring ADC demand back is OMP, which dot-zshenv
# still points at a Vertex model. It is invoked by hand, so a stale-ADC failure
# there already has a human in front of it, and this script is what that human
# runs. Wiring it to a session-start hook instead would re-create the browser
# stampede described below for a credential nothing is currently using.
#
# The browser is unavoidable, not a shortcoming of the escalation below: the
# reauth window is a Workspace policy, so no refresh_token grant defeats it.
# The only question any design here answers is *when* the human gets asked.
#
# Why it probes before escalating, which matters whenever it does run:
# a caller that decides credentials are "expired or cannot be loaded" can
# false-positive even when ADC is perfectly healthy, so going straight to
# `gcloud auth application-default login` throws a browser window at a session
# that did not need one.
#
# So probe first. `print-access-token` refreshes and returns a token from the
# stored refresh_token without any user interaction, and is a no-op costing
# well under a second when the credentials are already good. Only when that
# genuinely fails do we escalate to the interactive login.
#
# Absolute gcloud path on purpose: .zprofile only adds the SDK to PATH in login
# shells, and a GUI-launched Claude Code doesn't get one.
#
# The login flow stays the default browser-launching one. --no-browser and
# --no-launch-browser block on a pasted code, which needs stdin, and this
# script has to keep working from a caller that only shows its output.
#
# Two callers can hit an expired-credential error at the same moment and each
# run this script, so the login is single-flighted behind a lock: exactly one
# process opens a browser, the rest wait for it to finish and then re-probe.
# `mkdir` is the atomic primitive here because macOS has no
# flock(1); the lock records its owner PID so a crashed run doesn't wedge every
# later one.

GCLOUD=/opt/homebrew/share/google-cloud-sdk/bin/gcloud
[ -x "$GCLOUD" ] || GCLOUD=$(command -v gcloud) || {
	echo "gcp-auth-refresh: gcloud not found" >&2
	exit 1
}

LOCK_DIR="${TMPDIR:-/tmp}/gcp-auth-refresh.lock"
# Long enough for a browser login someone is actually completing, short enough
# that a wedged one still returns an error instead of hanging.
WAIT_SECONDS=150

probe() {
	"$GCLOUD" auth application-default print-access-token >/dev/null 2>&1
}

# True when the lock exists and its owner is still running.
lock_is_live() {
	owner=$(cat "$LOCK_DIR/pid" 2>/dev/null) || return 1
	[ -n "$owner" ] || return 1
	kill -0 "$owner" 2>/dev/null
}

if probe; then
	echo "gcp-auth-refresh: ADC already valid; no login needed."
	exit 0
fi

while :; do
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		echo $$ >"$LOCK_DIR/pid"
		trap 'rm -rf "$LOCK_DIR"' EXIT INT TERM
		break
	fi

	if ! lock_is_live; then
		echo "gcp-auth-refresh: clearing stale lock at $LOCK_DIR." >&2
		rm -rf "$LOCK_DIR"
		continue
	fi

	echo "gcp-auth-refresh: another login is already running; waiting for it."
	waited=0
	while [ "$waited" -lt "$WAIT_SECONDS" ] && lock_is_live; do
		sleep 2
		waited=$((waited + 2))
	done

	if probe; then
		echo "gcp-auth-refresh: the other login succeeded; nothing to do."
		exit 0
	fi

	if [ "$waited" -ge "$WAIT_SECONDS" ]; then
		echo "gcp-auth-refresh: timed out waiting for the in-flight login." >&2
		exit 1
	fi
	# The other login finished but ADC is still bad — retry for the lock.
done

# Re-probe under the lock: we may have raced a login that just succeeded.
if probe; then
	echo "gcp-auth-refresh: ADC already valid; no login needed."
	exit 0
fi

echo "gcp-auth-refresh: ADC could not mint a token; starting browser login."
"$GCLOUD" auth application-default login
