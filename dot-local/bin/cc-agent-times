#!/usr/bin/env python3
"""Report how long each Claude Code subagent ran in a session, and what it spent.

Subagent transcripts live at
  ~/.claude/projects/<slug>/<session-id>/subagents/agent-<id>.jsonl
so a subagent's wall time is its first-to-last entry timestamp. The name it was
spawned under sits beside it in agent-<id>.meta.json, not in the file name.

Token columns, which do not sum to a meaningful total since each class bills
at its own rate:

  in     fresh input, uncached
  cw     cache writes
  cr     cache reads
  out    output
  think  the thinking subset of out, already counted in it

Usage:
  cc-agent-times                 # newest session under the cwd's project slug
  cc-agent-times <session-id>    # a specific session, searched across projects
  cc-agent-times <path.jsonl>    # a specific session transcript
  cc-agent-times --grep TEXT     # newest session whose transcript contains TEXT
  cc-agent-times --agent NAME    # only subagents whose name or id contains NAME,
                                 # across every session under the cwd's slug
  cc-agent-times --json          # machine-readable rows, for cc-review-ab
"""

import argparse
import json
import os
import sys
from collections import Counter
from datetime import datetime
from pathlib import Path

PROJECTS = Path.home() / ".claude" / "projects"


def slug_for(path: Path) -> str:
    return str(path.resolve()).replace("/", "-").replace(".", "-")


def parse_ts(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def iter_entries(path: Path, skips: "Counter"):
    """Entries of a transcript, counting unparseable lines into skips."""
    with path.open() as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                skips["lines"] += 1


def project_dir() -> Path:
    project = PROJECTS / slug_for(Path.cwd())
    if not project.is_dir():
        sys.exit(f"no project dir for {Path.cwd()} (looked for {project})")
    return project


def spawned_name(path: Path) -> str:
    """The name a subagent was spawned under, or its transcript id when it has none."""
    fallback = path.stem.removeprefix("agent-")
    try:
        meta = json.loads(path.with_suffix(".meta.json").read_text())
    except (OSError, json.JSONDecodeError):
        return fallback
    return meta.get("name") or fallback


def subagent_transcripts(args):
    """(transcript paths, what was searched) for the requested scope.

    --agent with no session named searches every session under the cwd's slug:
    one worktree can hold several sessions, and the newest is often not the one
    that spawned the agent.
    """
    if args.agent and not args.target and not args.grep:
        project = project_dir()
        return sorted(project.glob("*/subagents/agent-*.jsonl")), f"every session under {project}"
    session = find_session(args)
    subagent_dir = session.with_suffix("") / "subagents"
    if not subagent_dir.is_dir():
        sys.exit(f"no subagents recorded for session {session}")
    return sorted(subagent_dir.glob("*.jsonl")), str(session)


def find_session(args) -> Path:
    if args.target and args.target.endswith(".jsonl"):
        return Path(args.target).expanduser()

    if args.target:
        matches = list(PROJECTS.glob(f"*/{args.target}.jsonl"))
        if not matches:
            sys.exit(f"no transcript found for session {args.target}")
        return matches[0]

    if args.grep:
        candidates = list(PROJECTS.glob("*/*.jsonl"))
        candidates.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        for candidate in candidates:
            if args.grep in candidate.read_text(errors="ignore"):
                return candidate
        sys.exit(f"no transcript contains {args.grep!r}")

    project = project_dir()
    sessions = sorted(project.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not sessions:
        sys.exit(f"no sessions under {project}")
    return sessions[0]


def first_prompt(entries) -> str:
    for entry in entries:
        if entry.get("type") != "user":
            continue
        content = entry.get("message", {}).get("content")
        if isinstance(content, str):
            return content
        if isinstance(content, list):
            for block in content:
                if block.get("type") == "text":
                    return block["text"]
    return ""


TOKEN_FIELDS = {
    "in": "input_tokens",
    "cw": "cache_creation_input_tokens",
    "cr": "cache_read_input_tokens",
    "out": "output_tokens",
}


def tally_tokens(entries) -> dict:
    """Per-class token totals across every assistant turn in a transcript."""
    totals = {name: 0 for name in TOKEN_FIELDS}
    totals["think"] = 0
    for entry in entries:
        if entry.get("type") != "assistant":
            continue
        usage = entry.get("message", {}).get("usage", {})
        for name, field in TOKEN_FIELDS.items():
            totals[name] += usage.get(field, 0)
        totals["think"] += usage.get("output_tokens_details", {}).get("thinking_tokens", 0)
    return totals


def human(count: int) -> str:
    """A token count, narrowed to fit a column."""
    if count < 1000:
        return str(count)
    if count < 1_000_000:
        return f"{count / 1000:.1f}k"
    return f"{count / 1_000_000:.2f}M"


def short_model(model: str) -> str:
    """"claude-opus-5-5" -> "opus-5-5", "claude-haiku-4-5-20251001" -> "haiku-4-5".

    The version stays because cc-review-ab splits its results by it. Ids without
    the claude- prefix stay whole: <synthetic>, and the bare opus/sonnet/inherit
    a transcript can carry."""
    name = model.removeprefix("claude-")
    head, _, tail = name.rpartition("-")
    return head if len(tail) == 8 and tail.isdigit() else name


def summarize(path: Path, skips: "Counter"):
    entries = list(iter_entries(path, skips))
    stamps = [parse_ts(e["timestamp"]) for e in entries if "timestamp" in e]
    if not stamps:
        skips["transcripts"] += 1
        return None

    models = {e["message"]["model"] for e in entries
              if e.get("type") == "assistant" and e.get("message", {}).get("model")}
    tools = sum(1 for e in entries if e.get("type") == "assistant"
                for b in e.get("message", {}).get("content", [])
                if isinstance(b, dict) and b.get("type") == "tool_use")
    label = " ".join(first_prompt(entries).split())[:70]
    return {
        "name": spawned_name(path),
        "start": min(stamps),
        "end": max(stamps),
        "seconds": (max(stamps) - min(stamps)).total_seconds(),
        "model": "+".join(sorted(short_model(m) for m in models)) or "?",
        "tools": tools,
        "tokens": tally_tokens(entries),
        "label": label,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", nargs="?", help="session id or transcript path")
    parser.add_argument("--grep", help="pick newest session whose transcript contains TEXT")
    parser.add_argument("--agent", help="only subagents whose id contains NAME")
    parser.add_argument("--json", action="store_true", help="emit rows as JSON")
    # Project slugs start with "-", which argparse would read as a flag.
    argv = sys.argv[1:]
    if argv and argv[0].startswith("-") and Path(argv[0]).exists():
        argv = ["--", *argv]
    args = parser.parse_args(argv)

    paths, searched = subagent_transcripts(args)
    if not args.json:
        print(f"session: {searched}")
    if args.agent:
        # Filter before summarizing, which parses every line of each transcript.
        paths = [p for p in paths if args.agent in spawned_name(p) or args.agent in p.stem]

    # A truncated transcript otherwise understates every number below, silently.
    skips = Counter()
    rows = [r for r in (summarize(p, skips) for p in paths) if r]
    if skips["lines"]:
        print(f"warning: skipped {skips['lines']} unparseable transcript line(s)", file=sys.stderr)
    if skips["transcripts"]:
        print(f"warning: skipped {skips['transcripts']} transcript(s) with no timestamps",
              file=sys.stderr)
    if not rows:
        sys.exit(f"no subagent matches {args.agent!r}" if args.agent
                 else "no subagent entries with timestamps")

    rows.sort(key=lambda r: r["seconds"], reverse=True)
    t0 = min(r["start"] for r in rows)
    span = (max(r["end"] for r in rows) - t0).total_seconds()

    if args.json:
        print(json.dumps([{
            "name": r["name"], "seconds": round(r["seconds"], 1),
            "model": r["model"], "tools": r["tools"], **r["tokens"],
        } for r in rows], indent=2))
        return

    cols = ["in", "cw", "cr", "out", "think"]
    width = max(len(r["name"]) for r in rows)
    print(f"{len(rows)} subagents, {span:.0f}s wall from first start to last finish\n")
    header = f"{'agent'.ljust(width)}  {'secs':>6}  {'+start':>6}  {'model':<10} {'tools':>5}"
    print(header + "".join(f"  {c:>7}" for c in cols) + "  prompt")
    for row in rows:
        offset = (row["start"] - t0).total_seconds()
        cells = "".join(f"  {human(row['tokens'][c]):>7}" for c in cols)
        print(f"{row['name'].ljust(width)}  {row['seconds']:6.0f}  {offset:6.0f}  "
              f"{row['model']:<10} {row['tools']:5d}{cells}  {row['label'][:40]}")

    totals = {c: sum(r["tokens"][c] for r in rows) for c in cols}
    print(f"{'total'.ljust(width)}  {sum(r['seconds'] for r in rows):6.0f}  {'':6}  "
          f"{'':<10} {sum(r['tools'] for r in rows):5d}"
          + "".join(f"  {human(totals[c]):>7}" for c in cols))

    slowest = rows[0]
    # span is 0 when every subagent failed at the same instant.
    share = f" ({slowest['seconds'] / span * 100:.0f}% of the fan-out window)" if span else ""
    print(f"\nslowest: {slowest['name']} at {slowest['seconds']:.0f}s{share}")


if __name__ == "__main__":
    main()
