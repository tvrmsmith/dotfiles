#!/usr/bin/env python3
"""Report how long each Claude Code subagent ran in a session.

Subagent transcripts live at
  ~/.claude/projects/<slug>/<session-id>/subagents/agent-*.jsonl
so a subagent's wall time is its first-to-last entry timestamp.

Usage:
  cc-agent-times                 # newest session under the cwd's project slug
  cc-agent-times <session-id>    # a specific session, searched across projects
  cc-agent-times <path.jsonl>    # a specific session transcript
  cc-agent-times --grep TEXT     # newest session whose transcript contains TEXT
"""

import argparse
import json
import os
import sys
from collections import Counter
from datetime import datetime
from pathlib import Path

PROJECTS = Path.home() / ".claude" / "projects"


def slug_for(path: Path) -> str:
    return str(path.resolve()).replace("/", "-").replace(".", "-")


def parse_ts(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def iter_entries(path: Path, skips: "Counter"):
    """Entries of a transcript, counting unparseable lines into skips."""
    with path.open() as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                skips["lines"] += 1


def find_session(args) -> Path:
    if args.target and args.target.endswith(".jsonl"):
        return Path(args.target).expanduser()

    if args.target:
        matches = list(PROJECTS.glob(f"*/{args.target}.jsonl"))
        if not matches:
            sys.exit(f"no transcript found for session {args.target}")
        return matches[0]

    if args.grep:
        candidates = list(PROJECTS.glob("*/*.jsonl"))
        candidates.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        for candidate in candidates:
            if args.grep in candidate.read_text(errors="ignore"):
                return candidate
        sys.exit(f"no transcript contains {args.grep!r}")

    project = PROJECTS / slug_for(Path.cwd())
    if not project.is_dir():
        sys.exit(f"no project dir for {Path.cwd()} (looked for {project})")
    sessions = sorted(project.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not sessions:
        sys.exit(f"no sessions under {project}")
    return sessions[0]


def first_prompt(entries) -> str:
    for entry in entries:
        if entry.get("type") != "user":
            continue
        content = entry.get("message", {}).get("content")
        if isinstance(content, str):
            return content
        if isinstance(content, list):
            for block in content:
                if block.get("type") == "text":
                    return block["text"]
    return ""


def short_model(model: str) -> str:
    """"claude-opus-5-20260101" -> "opus". Ids without a hyphen stay whole:
    <synthetic>, and the bare opus/sonnet/inherit a transcript can carry."""
    parts = model.split("-")
    return parts[1] if len(parts) > 1 else model


def summarize(path: Path, skips: "Counter"):
    entries = list(iter_entries(path, skips))
    stamps = [parse_ts(e["timestamp"]) for e in entries if "timestamp" in e]
    if not stamps:
        skips["transcripts"] += 1
        return None

    models = {e["message"]["model"] for e in entries
              if e.get("type") == "assistant" and e.get("message", {}).get("model")}
    tools = sum(1 for e in entries if e.get("type") == "assistant"
                for b in e.get("message", {}).get("content", [])
                if isinstance(b, dict) and b.get("type") == "tool_use")
    out_tokens = sum(e.get("message", {}).get("usage", {}).get("output_tokens", 0)
                     for e in entries if e.get("type") == "assistant")

    label = " ".join(first_prompt(entries).split())[:70]
    return {
        "name": path.stem.removeprefix("agent-"),
        "start": min(stamps),
        "end": max(stamps),
        "seconds": (max(stamps) - min(stamps)).total_seconds(),
        "model": "+".join(sorted(short_model(m) for m in models)) or "?",
        "tools": tools,
        "out_tokens": out_tokens,
        "label": label,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", nargs="?", help="session id or transcript path")
    parser.add_argument("--grep", help="pick newest session whose transcript contains TEXT")
    # Project slugs start with "-", which argparse would read as a flag.
    argv = sys.argv[1:]
    if argv and argv[0].startswith("-") and Path(argv[0]).exists():
        argv = ["--", *argv]
    args = parser.parse_args(argv)

    session = find_session(args)
    subagent_dir = session.with_suffix("") / "subagents"
    print(f"session: {session}")

    if not subagent_dir.is_dir():
        sys.exit("no subagents recorded for this session")

    # A truncated transcript otherwise understates every number here silently:
    # the durations, the subagent count, and the fan-out denominator below.
    skips = Counter()
    rows = [r for r in (summarize(p, skips) for p in sorted(subagent_dir.glob("*.jsonl"))) if r]
    if skips["lines"]:
        print(f"warning: skipped {skips['lines']} unparseable transcript line(s)", file=sys.stderr)
    if skips["transcripts"]:
        print(f"warning: skipped {skips['transcripts']} transcript(s) with no timestamps",
              file=sys.stderr)
    if not rows:
        sys.exit("no subagent entries with timestamps")

    rows.sort(key=lambda r: r["seconds"], reverse=True)
    t0 = min(r["start"] for r in rows)
    span = (max(r["end"] for r in rows) - t0).total_seconds()

    width = max(len(r["name"]) for r in rows)
    print(f"{len(rows)} subagents, {span:.0f}s wall from first start to last finish\n")
    print(f"{'agent'.ljust(width)}  {'secs':>6}  {'+start':>6}  {'model':<8} {'tools':>5}  {'out tok':>8}  prompt")
    for row in rows:
        offset = (row["start"] - t0).total_seconds()
        print(f"{row['name'].ljust(width)}  {row['seconds']:6.0f}  {offset:6.0f}  "
              f"{row['model']:<8} {row['tools']:5d}  {row['out_tokens']:8d}  {row['label']}")

    slowest = rows[0]
    # span is 0 when every subagent failed at the same instant.
    share = f" ({slowest['seconds'] / span * 100:.0f}% of the fan-out window)" if span else ""
    print(f"\nslowest: {slowest['name']} at {slowest['seconds']:.0f}s{share}")


if __name__ == "__main__":
    main()
