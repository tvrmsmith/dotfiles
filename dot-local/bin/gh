#!/usr/bin/env bash
# gh — run the real gh with the token of the account that owns the repo.
#
# One classic token per GitHub account, kept in the OS keyring under the
# service gh-token and keyed by owner login. gh-token-sync copies them there
# from 1Password; a machine without the sync gets them by hand with
# `gh-keyring set gh-token <owner>`. Nothing here asks for an approval: agents
# act as Trevor, and the token is the whole credential. See
# docs/adr/0002-agents-use-synced-classic-tokens.md.
#
# Why a shim at all, when gh can hold both accounts itself: gh has one active
# account per host, and `gh auth switch` rewrites a hosts.yml shared by every
# agent running in parallel. Picking the token per call, from the repo's owner,
# keeps a personal-repo call off the work account and the reverse. git uses this
# file as its HTTPS credential helper for the same reason.
#
# GH_SHIM_EXPLAIN=1 gh <args> prints the owner and whether a token was found, and
# runs nothing.

set -euo pipefail

# Follow a symlink chain to the file itself. BSD readlink has no -f, and a link
# body is relative to the link's own directory, not to $PWD — this file is
# reached through ~/.local/bin/gh -> ../../dev/personal/dotfiles/....
canon() {
	local src="$1" dir
	while [ -h "$src" ]; do
		dir="$(cd -P "$(dirname "$src")" && pwd)"
		src="$(readlink "$src")"
		[ "${src#/}" = "$src" ] && src="$dir/$src"
	done
	printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}

self="$(canon "${BASH_SOURCE[0]}")"

# The directory this shim was found in, unresolved: that is the entry to drop
# from PATH later, not the repo path the symlink points at.
shim_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The next `gh` on PATH that is not this script. Scanned rather than hardcoding
# /opt/homebrew/bin/gh, which differs on Linux and on Intel.
real_gh=""
while IFS= read -r candidate; do
	[ -x "$candidate" ] || continue
	[ "$(canon "$candidate")" = "$self" ] && continue
	real_gh="$candidate"
	break
done < <(type -aP gh)

# Nothing on PATH is the expected case on Trevor's machines: install.sh runs
# `brew unlink gh`, so the Cellar binary is reachable through Homebrew's `opt`
# link but carries no bare `gh` anywhere on PATH. That is deliberate. A shim
# that shares the name with the real binary only wins while it is earlier on
# PATH, and Claude Code pins a captured PATH in its shell snapshot that the
# .zprofile/.zshrc hoist never gets to correct, so the race was lost in most
# agent shells. With no competitor there is no race, in any launcher. The `opt`
# link is read directly rather than through `brew --prefix gh`, which costs a
# subprocess on every gh call. See dotfiles-asc.
if [ -z "$real_gh" ]; then
	for prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
		[ -n "$prefix" ] || continue
		if [ -x "$prefix/opt/gh/bin/gh" ]; then
			real_gh="$prefix/opt/gh/bin/gh"
			break
		fi
	done
fi

if [ -z "$real_gh" ]; then
	echo "gh shim: no real gh binary found on PATH or in a Homebrew opt prefix" >&2
	exit 127
fi

# An explicitly exported token is a deliberate override (CI, a one-off `GH_TOKEN=...
# gh ...`), so honour it and get out of the way.
if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
	exec "$real_gh" "$@"
fi

# Tokens are keyed by GitHub resource owner. A classic token covers every owner
# its account can reach, so the sync stores the same token under each owner it
# serves (the work user and the work org, say), and a lookup stays one key.
#
# Resolved per invocation and passed as GH_TOKEN. Never `gh auth switch`: that
# rewrites a shared hosts.yml, and several agents run here in parallel.

# The owner segment of a GitHub remote URL, or failure for anything else. The
# host check is what keeps a filesystem remote (`git clone /path/to/repo.git`,
# the no-mistakes gate repos) from yielding "Users" as an owner.
owner_from_url() {
	local url="${1%.git}" host
	url="${url#*://}"                       # https://github.com/owner/repo
	url="${url#*@}"                         # git@github.com:owner/repo
	host="${url%%[:/]*}"
	case "$host" in
		github.com | github-*) ;;
		*) return 1 ;;
	esac
	url="${url#"$host"}"
	url="${url#[:/]}"
	case "$url" in
		*/*) printf '%s\n' "${url%%/*}" ;;
		*) return 1 ;;
	esac
}

gh_owner() {
	local prev="" arg spec
	for arg in "$@"; do
		case "$prev" in
			-R|--repo) spec="$arg" ;;
		esac
		case "$arg" in
			-R?*) spec="${arg#-R}" ;;
			--repo=*) spec="${arg#--repo=}" ;;
		esac
		prev="$arg"
	done
	if [ -n "${spec:-}" ]; then
		# host/owner/repo is also legal in -R.
		spec="${spec#*://}"
		case "$spec" in */*/*) spec="${spec#*/}" ;; esac
		printf '%s\n' "${spec%%/*}"
		return
	fi

	# `gh repo view|clone owner/repo` and `gh repo list owner` name the owner
	# positionally, and gh rejects -R on those, so the scan above sees nothing.
	local pos=""
	if [ "${1:-}" = repo ]; then
		case "${2:-}" in view | clone | list) pos="${3:-}" ;; esac
	fi
	case "$pos" in
		"" | -*) ;;
		*)
			pos="${pos#*://}"
			case "$pos" in */*/*) pos="${pos#*/}" ;; esac
			printf '%s\n' "${pos%%/*}"
			return ;;
	esac

	# `gh api /repos/OWNER/...` puts the owner in the path. gh also accepts
	# {owner} as a placeholder it fills from the current repo, which names no
	# owner of its own, so leave that to the remotes below.
	if [ "${1:-}" = api ]; then
		for arg in "$@"; do
			arg="${arg#/}"
			case "$arg" in
				repos/'{'*) break ;;
				repos/*/*) arg="${arg#repos/}" ;;
				orgs/'{'* | users/'{'*) break ;;
				orgs/* | users/*) arg="${arg#*/}" ;;
				*) continue ;;
			esac
			printf '%s\n' "${arg%%/*}"
			return
		done
	fi

	# git reads the shared config from any linked worktree, so a worktree parked
	# in /var/folders or ~/.superset/worktrees resolves the same owner as its
	# main checkout. Path never enters into it.
	#
	# origin first, then any other remote: a gate repo or a local clone can hold
	# a filesystem origin while the real GitHub URL sits on a second remote.
	#
	# Read whole before the loop, not streamed into it. The loop returns on the
	# first match, and a writer still feeding a closed pipe gets EPIPE: under a
	# parent that ignores SIGPIPE, GNU cut then printed "write error: Broken
	# pipe" on every Linux gh call. BSD cut stayed quiet, so macOS never showed it.
	local url owner key urls
	urls="$(
		git config --get remote.origin.url 2>/dev/null || true
		git config --get-regexp '^remote\..*\.url$' 2>/dev/null || true
	)"
	while IFS= read -r url; do
		# --get-regexp lines are "remote.NAME.url URL"; origin's line is bare.
		case "$url" in remote.*' '*) key="${url%% *}"; url="${url#"$key" }" ;; esac
		[ -n "$url" ] || continue
		owner="$(owner_from_url "$url")" && [ -n "$owner" ] && { printf '%s\n' "$owner"; return; }
	done <<< "$urls"

	dir_owner
}

# Outside a repo: `gh api /user`, `gh search`. The same directory rule
# ~/.gitconfig uses for identity, and the borrowed-token fallback below.
dir_owner() {
	case "$PWD/" in
		"$HOME"/dev/personal/*) printf 'tvrmsmith\n' ;;
		*) printf '%s\n' "${GH_DEFAULT_OWNER:-TrevorSmith-Wellsky}" ;;
	esac
}

# Which keyring (macOS keychain, Linux Secret Service) is gh-keyring's business,
# so nothing below this line knows what OS it is on.
#
# Found beside this file's real path, not beside the link to it. install.sh
# makes ~/.local/bin a real directory, so stow links its files one by one and a
# new helper has no link there until the next install. The repo copy always
# exists, and in a sandbox that copies dot-local/bin the two directories are the
# same.
keyring="$(dirname "$self")/gh-keyring"
keychain_token() {
	# A token never holds whitespace. A lone "\r" once landed in the keyring (a
	# hidden prompt read in a terminal that sent CR), and `[ -n "$token" ]` let it
	# through as an Authorization header gh rejected. Strip it, and treat what is
	# left being empty as no token.
	local token
	token="$("$keyring" get gh-token "$1" 2>/dev/null | tr -d '[:space:]')" || return 1
	[ -n "$token" ] || return 1
	printf '%s\n' "$token"
}

# The repo owner's token first, then the token for the directory's account. A
# repo whose owner has no token here is usually a third party (an upstream, a
# public dependency), and the account you are working as is the right identity
# for it.
owner="$(gh_owner "$@")"
token="" used=""
for candidate in "$owner" "$(dir_owner)"; do
	[ -n "$candidate" ] || continue
	if token="$(keychain_token "$candidate")"; then
		used="$candidate"
		break
	fi
	token=""
done

if [ -n "${GH_SHIM_EXPLAIN:-}" ]; then
	if [ -n "$used" ]; then
		echo "owner $owner token $used"
	else
		echo "owner $owner token none"
	fi
	exit 0
fi

# No token on this machine: let the real gh use its own login, or none.
[ -n "$token" ] || exec "$real_gh" "$@"
exec env GH_TOKEN="$token" "$real_gh" "$@"
