[gpg]
	format = ssh
[gpg "ssh"]
	# Resolved off PATH (~/.local/bin, stowed from dot-local/bin), not pinned to
	# an absolute path: the wrapper already picks the right 1Password binary per
	# platform, and any absolute prefix makes every commit on another machine die
	# with "cannot exec". git does a PATH lookup for a bare name here but does
	# NOT expand ~, so a bare command name is the only portable spelling.
	program = op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDCVsIviMhYuKXaXPDnU47cBmR3h2eiKq59GmS+uFvPe
	name = Trevor Smith
	email = trevor.smith@wellsky.com
[alias]
	up = pull --rebase
	# Advance the base branch from its remote, then rebase the current branch
	# onto it. Defaults: base "main", remote "upstream"; override as
	# `git sync <base> <remote>`. On the base branch itself, fast-forward only
	# and skip the rebase. The `fetch . <remote>/<base>:<base>` spelling updates
	# the base branch without checking it out, and refuses a non-fast-forward.
	sync = "!f() { b=${1:-main}; r=${2:-upstream}; git fetch $r --prune || return 1; if [ \"$(git symbolic-ref --short HEAD)\" = \"$b\" ]; then git merge --ff-only $r/$b; else git fetch . $r/$b:$b && git rebase $b; fi; }; f"
[merge "ours"]
	driver = true
[core]
	pager = delta
[diff]
  # Neovim diff tool
  tool = nvimdiff
[delta]
# minus-style                   = syntax "#4b2a3d"
# minus-non-emph-style          = syntax "#4b2a3d"
# minus-emph-style              = syntax "#6b2e43"
# minus-empty-line-marker-style = syntax "#4b2a3d"
# line-numbers-minus-style      = "#e26a75"
# plus-style                    = syntax "#2a4556"
# plus-non-emph-style           = syntax "#2a4556"
# plus-emph-style               = syntax "#305f6f"
# plus-empty-line-marker-style  = syntax "#2a4556"
# line-numbers-plus-style       = "#b8db87"
# line-numbers-zero-style       = "#3b4261"
	navigate = true
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[pull]
	rebase = true

# Sandbox overrides (no-op on host if file doesn't exist)
[include]
	path = ~/.gitconfig.sandbox

# Personal repos under ~/dev/personal/ get personal identity and sandbox signing key
[includeIf "gitdir:~/dev/personal/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/dev/personal/"]
	path = ~/.gitconfig.sandbox-personal

# Personal repos cloned outside ~/dev/personal/ (e.g. this dotfiles repo lives
# at ~/dev/dotfiles) — matched by remote instead of path so identity follows
# the repo regardless of where it's checked out.
[includeIf "hasconfig:remote.*.url:git@github.com:tvrmsmith/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:tvrmsmith/**"]
	path = ~/.gitconfig.sandbox-personal

# Machine-local identity override — e.g. on a personal-only machine, set
# [user] here to make the personal identity the default everywhere instead
# of relying on the includeIf rules above. No-op if file doesn't exist.
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
