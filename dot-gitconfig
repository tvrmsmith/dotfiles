[gpg]
	format = ssh
[gpg "ssh"]
	# No `program` line on purpose: git falls back to plain ssh-keygen off PATH.
	# This used to be the op-ssh-sign wrapper, which made every single commit a
	# round trip to the 1Password SSH agent, and every round trip a desktop
	# approval — the agent binds a remembered approval to the requesting
	# process, so an agent's short-lived `git commit` never reuses one, and the
	# no-mistakes daemon could not sign at all. Signing now uses a local key
	# file (see user.signingkey). See dotfiles-udc.
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[user]
	# Path to the private key, not the literal public key: ssh-keygen signs from
	# the file with no agent involved. git DOES expand a leading ~ here (unlike
	# gpg.ssh.program above), so this stays portable across machines. The key is
	# generated per machine and never committed — this repo is public, and
	# ~/.ssh/allowed_signers carries the public half.
	signingkey = ~/.ssh/git-sign-work
	name = Trevor Smith
	email = trevor.smith@wellsky.com
[alias]
	up = pull --rebase
	# Advance the base branch from its remote, then rebase the current branch
	# onto it. Defaults: base "main", remote "upstream"; override as
	# `git sync <base> <remote>`. On the base branch itself, fast-forward only
	# and skip the rebase. The `fetch . <remote>/<base>:<base>` spelling updates
	# the base branch without checking it out, and refuses a non-fast-forward.
	sync = "!f() { b=${1:-main}; r=${2:-upstream}; git fetch $r --prune || return 1; if [ \"$(git symbolic-ref --short HEAD)\" = \"$b\" ]; then git merge --ff-only $r/$b; else git fetch . $r/$b:$b && git rebase $b; fi; }; f"
[merge "ours"]
	driver = true
[core]
	pager = delta
[diff]
  # Neovim diff tool
  tool = nvimdiff
[delta]
# minus-style                   = syntax "#4b2a3d"
# minus-non-emph-style          = syntax "#4b2a3d"
# minus-emph-style              = syntax "#6b2e43"
# minus-empty-line-marker-style = syntax "#4b2a3d"
# line-numbers-minus-style      = "#e26a75"
# plus-style                    = syntax "#2a4556"
# plus-non-emph-style           = syntax "#2a4556"
# plus-emph-style               = syntax "#305f6f"
# plus-empty-line-marker-style  = syntax "#2a4556"
# line-numbers-plus-style       = "#b8db87"
# line-numbers-zero-style       = "#3b4261"
	navigate = true
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[pull]
	rebase = true

# Sandbox overrides (no-op on host if file doesn't exist)
[include]
	path = ~/.gitconfig.sandbox

# Personal repos under ~/dev/personal/ get personal identity and sandbox signing key
[includeIf "gitdir:~/dev/personal/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/dev/personal/"]
	path = ~/.gitconfig.sandbox-personal

# Personal repos cloned outside ~/dev/personal/ (e.g. this dotfiles repo lives
# at ~/dev/dotfiles) — matched by remote instead of path so identity follows
# the repo regardless of where it's checked out.
[includeIf "hasconfig:remote.*.url:git@github.com:tvrmsmith/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:tvrmsmith/**"]
	path = ~/.gitconfig.sandbox-personal

# Same rule for the github-personal SSH host alias. Personal remotes are
# written that way, and the no-mistakes daemon clones its gate repos to
# ~/.no-mistakes/repos/<hash>.git, outside every gitdir rule above, so without
# this the daemon's pipeline commits are authored as the work identity.
[includeIf "hasconfig:remote.*.url:git@github-personal:tvrmsmith/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github-personal:tvrmsmith/**"]
	path = ~/.gitconfig.sandbox-personal

# Machine-local identity override — e.g. on a personal-only machine, set
# [user] here to make the personal identity the default everywhere instead
# of relying on the includeIf rules above. No-op if file doesn't exist.
[include]
	path = ~/.gitconfig.local
# No gh credential helper on purpose. `gh auth login` used to leave a
# write-scoped token in gh's keyring, which the helper handed to git, and which
# also let anything calling the real gh binary write to GitHub with no
# 1Password approval. The account is logged out now so ~/.local/bin/gh is the
# only path to a credential, which leaves `gh auth git-credential` with nothing
# to return. Every remote here is ssh, so nothing asked for it anyway. See
# dotfiles-7wt.
